# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASS=tu_password

# Configuración de Sistema de Archivos / Portadas
# Opciones para FS_DRIVER: local | cloudinary
FS_DRIVER=local

# Credenciales de Cloudinary (solo necesarias si FS_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret